# Porta do servidor
PORT=3001

# Origem permitida para CORS em produção (URL pública do site).
# Em desenvolvimento pode deixar em branco: o Vite acessa via proxy (mesma origem).
CORS_ORIGIN=

# E-mail que recebe os leads do formulário de contato
LEAD_TO_EMAIL=

# Configuração SMTP (opcional). Se não preenchida, os leads são apenas
# registrados no console e salvos em server/leads.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Site Dy Negócios" <site@dynegocios.com.br>
